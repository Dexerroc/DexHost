OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Netlify Identity is resolved automatically inside Netlify Functions.
# Set this only for custom/local Identity endpoints.
NETLIFY_IDENTITY_URL=

# Netlify Blobs stores used by the Functions.
NETLIFY_BLOBS_DATA_STORE=dexhost-data
NETLIFY_BLOBS_ASSET_STORE=dexhost-assets

# Publishing / Domains
DEXHOST_PRIMARY_DOMAIN=dexhost.de
DEXHOST_SUBDOMAIN_SUFFIX=dexhost.de
NETLIFY_SITE_ID=
NETLIFY_API_TOKEN=
NETLIFY_BUILD_HOOK_URL=

IMAGE_UPLOAD_MAX_BYTES=5242880
VITE_IMAGE_UPLOAD_MAX_BYTES=5242880
